<?xml version="1.0"?>
<!-- ==========================================================================
     humanoid_v4_atom.urdf  —  humanoid_v3 with the real ATOM arm hardware
     ==========================================================================
     The v3 arms were boxes: 0.30m uparm + 0.28m forearm, 0.8kg / 0.6kg, made up.
     Both arms are now the actual SolidWorks arm assembly - real meshes, real
     masses, real inertia tensors, real elbow travel.

     JOINT NAMES AND SIGN CONVENTIONS ARE UNCHANGED from v3, so pose_sender.py
     and the retargeting need no edits:
         *_shoulder_flex  axis (0 -1 0)  positive = FORWARD
         *_shoulder_abd   axis (+/-1 0 0) positive = OUT TO THE SIDE
         *_elbow          axis (0 -1 0)  positive = folds forearm FORWARD

     WHAT CHANGED, AND WHY IT MATTERS
     --------------------------------
     * Elbow travel is now 0 -> 2.0944 rad (120 deg), not 0 -> 2.7 (155 deg).
       2.7 was fictional. The real forearm mesh hits the real bicep mesh at
       ~2.007 rad. Commands beyond that are now stopped by CONTACT, not by a
       number in a file. This is the clipping fix.
     * Arm mass per side: 0.586 kg, was 1.4 kg. Segment lengths are shorter too
       (bicep 178mm vs 300mm). The figure will look different. That difference
       IS the hardware - it is the point of the swap.

     STRUCTURE
     ---------
     The ATOM arm's elbow axis is X; this humanoid's is -Y. Rather than rewrite
     every offset, each arm gets a fixed "adapter" joint rotating +90deg about Z.
     Downstream of the adapter the geometry is byte-identical to atom_arm.urdf,
     so when mechanical re-exports there is exactly one file to update.

         *_uparm  --[adapter, fixed]--> *_bicep --[*_elbow]--> *_forearm

     SHOULDER TRACK WIDENED: 0.20 -> 0.28 m
     The real bicep is 109mm wide and part of it sits ABOVE the shoulder pivot,
     so it swings inboard when the shoulder abducts. At the v3 spacing it cut
     3.8mm into the chest at a normal guard pose. The real arm does not fit the
     v3 torso - the mount has to move outboard. Flagging for mechanical.

     ABDUCTION LOWER LIMIT RAISED: -0.5 -> -0.20 rad (-28.6 -> -11.5 deg)
     Swept the full flex x abd x elbow workspace against the torso. Below
     -11.5 deg the arm drives into the chest, up to 93mm deep at the old -0.5
     limit. -0.20 rad is collision-free everywhere. If mechanical wants more
     inward travel, the torso has to get narrower or the shoulder move out.

     KNOWN GAPS
     ----------
     * `forearmelbowV2` was never given its own link in the SolidWorks export,
       so that part has no STL. It shows as a gap at the elbow. Needs re-export.
     * There is no shoulder in the CAD. The shoulder joints below are the v3
       humanoid's own invented joints, NOT mechanical's design.
     * Both sides use the same (non-mirrored) part. The real robot needs a
       mirrored left/right pair.
     * effort/velocity on the elbow are [PLACEHOLDER] pending servo datasheets.
     * Gears are visual only. The reduction (~2.24:1) belongs in the actuator.
     ========================================================================== -->
<robot name="humanoid_v4_atom">

  <mujoco>
    <compiler meshdir="meshes/" balanceinertia="true" discardvisual="false"/>
  </mujoco>

  <material name="gray"><color rgba="0.45 0.47 0.52 1"/></material>
  <material name="tan"><color rgba="0.85 0.72 0.6 1"/></material>
  <material name="blue"><color rgba="0.2 0.5 0.9 1"/></material>
  <material name="orange"><color rgba="0.95 0.55 0.2 1"/></material>
  <material name="steel"><color rgba="0.79 0.82 0.93 1"/></material>
  <material name="brass"><color rgba="1.0 0.95 0.91 1"/></material>

  <!-- ============================ TORSO (root) ============================ -->
  <link name="torso">
    <visual>
      <geometry><box size="0.20 0.34 0.65"/></geometry>
      <origin xyz="0 0 0.325"/>
      <material name="gray"/>
    </visual>
    <collision><geometry><box size="0.20 0.34 0.65"/></geometry><origin xyz="0 0 0.325"/></collision>
    <inertial><mass value="8.0"/><inertia ixx="0.1" iyy="0.1" izz="0.05" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual>
      <geometry><sphere radius="0.11"/></geometry>
      <origin xyz="0 0 0.78"/>
      <material name="tan"/>
    </visual>
  </link>

  <!-- ============================== LEFT ARM ============================== -->
  <joint name="L_shoulder_flex" type="revolute">
    <parent link="torso"/><child link="L_shoulder_link"/>
    <origin xyz="0 0.28 0.6"/><axis xyz="0 -1 0"/>
    <limit lower="-1.2" upper="3.1" effort="30" velocity="8"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>
  <link name="L_shoulder_link">
    <inertial><mass value="0.05"/><inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="L_shoulder_abd" type="revolute">
    <parent link="L_shoulder_link"/><child link="L_uparm"/>
    <origin xyz="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.20" upper="3.0" effort="30" velocity="8"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>
  <!-- massless frame: keeps the humanoid's axis conventions intact -->
  <link name="L_uparm">
    <inertial><mass value="0.001"/><inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- +90deg about Z aligns the ATOM arm's X elbow axis with this rig's -Y -->
  <joint name="L_arm_adapter" type="fixed">
    <parent link="L_uparm"/><child link="L_bicep"/>
    <origin xyz="0.042 0 0" rpy="0 0 1.5707963"/>
  </joint>

  <link name="L_bicep">
    <inertial>
      <origin xyz="-1.42283694379852E-05 0.0379551502038027 -0.00905701308974227"/>
      <mass value="0.245418330630813"/>
      <inertia ixx="0.00101630914167305" ixy="-1.08640924982468E-10" ixz="-1.60895885208619E-07"
               iyy="0.00110356103582406" iyz="-1.18509244220687E-06" izz="0.000517235924522898"/>
    </inertial>
    <visual><geometry><mesh filename="bicep_Link.STL"/></geometry><material name="blue"/></visual>
    <collision><geometry><mesh filename="bicep_Link.STL"/></geometry></collision>
  </link>

  <joint name="L_elbow_bracket_fixed" type="fixed">
    <parent link="L_bicep"/><child link="L_elbow_bracket"/>
    <origin xyz="-2.83612166021019E-05 -0.000342777510980219 -0.125641150102891"/>
  </joint>
  <link name="L_elbow_bracket">
    <inertial>
      <origin xyz="-0.000605555742169805 0.0394739809491743 -0.0108109614483796"/>
      <mass value="0.158178833168892"/>
      <inertia ixx="0.000243570804084392" ixy="-1.31464920678115E-07" ixz="2.56905954631695E-06"
               iyy="0.000332684193087832" iyz="4.1878302215505E-06" izz="0.000317444119465918"/>
    </inertial>
    <visual><geometry><mesh filename="elbow_Link.STL"/></geometry><material name="blue"/></visual>
    <collision><geometry><mesh filename="elbow_Link.STL"/></geometry></collision>
  </link>

  <joint name="L_small_gear_fixed" type="fixed">
    <parent link="L_bicep"/><child link="L_small_gear"/>
    <origin xyz="0.023071638783 0.037757222489 -0.140201150103"/>
  </joint>
  <link name="L_small_gear">
    <inertial>
      <origin xyz="-0.009 0 0"/><mass value="0.00629688353529975"/>
      <inertia ixx="4.33270428790079E-07" ixy="0" ixz="0" iyy="3.86651069848133E-07" iyz="0" izz="3.86651069848133E-07"/>
    </inertial>
    <visual><geometry><mesh filename="small_gear_Link.STL"/></geometry><material name="brass"/></visual>
  </link>

  <!-- rpy re-zeros the elbow: 0 = extended, +2.0944 = folded against the bicep -->
  <joint name="L_elbow" type="revolute">
    <parent link="L_bicep"/><child link="L_forearm"/>
    <origin xyz="-2.83612166021019E-05 0.037758222489 -0.178242150103" rpy="1.5707963 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="2.0944" effort="5.0" velocity="3.0"/>
    <dynamics damping="0.15" friction="0.05"/>
  </joint>
  <link name="L_forearm">
    <inertial>
      <origin xyz="0.000135400 -0.130406796594 0.001104478776"/>
      <mass value="0.138255156587189"/>
      <inertia ixx="0.000259996515223128" ixy="-7.95456854559555E-08" ixz="-2.43754362058068E-09"
               iyy="9.63598208364411E-05" iyz="-5.85531936751054E-06" izz="0.000284931810112051"/>
    </inertial>
    <visual>
      <origin xyz="0.000135398765666483 -0.124737633197 0.024618598898"/>
      <geometry><mesh filename="short_arm_link.STL"/></geometry><material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.000135398765666483 -0.124737633197 0.024618598898"/>
      <geometry><mesh filename="short_arm_link.STL"/></geometry>
    </collision>
  </link>

  <joint name="L_big_gear_fixed" type="fixed">
    <parent link="L_forearm"/><child link="L_big_gear"/>
    <origin xyz="0.0231 0 0"/>
  </joint>
  <link name="L_big_gear">
    <inertial>
      <origin xyz="-0.009 0 0"/><mass value="0.0382194359196154"/>
      <inertia ixx="1.45911616699868E-05" ixy="0" ixz="0" iyy="8.32211862139204E-06" iyz="0" izz="8.33289258825403E-06"/>
    </inertial>
    <visual><geometry><mesh filename="big_gear_Link.STL"/></geometry><material name="brass"/></visual>
  </link>

  <!-- ============================= RIGHT ARM ============================= -->
  <joint name="R_shoulder_flex" type="revolute">
    <parent link="torso"/><child link="R_shoulder_link"/>
    <origin xyz="0 -0.28 0.6"/><axis xyz="0 -1 0"/>
    <limit lower="-1.2" upper="3.1" effort="30" velocity="8"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>
  <link name="R_shoulder_link">
    <inertial><mass value="0.05"/><inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="R_shoulder_abd" type="revolute">
    <parent link="R_shoulder_link"/><child link="R_uparm"/>
    <origin xyz="0 0 0"/><axis xyz="-1 0 0"/>
    <limit lower="-0.20" upper="3.0" effort="30" velocity="8"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>
  <link name="R_uparm">
    <inertial><mass value="0.001"/><inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="R_arm_adapter" type="fixed">
    <parent link="R_uparm"/><child link="R_bicep"/>
    <origin xyz="0.042 0 0" rpy="0 0 1.5707963"/>
  </joint>

  <link name="R_bicep">
    <inertial>
      <origin xyz="-1.42283694379852E-05 0.0379551502038027 -0.00905701308974227"/>
      <mass value="0.245418330630813"/>
      <inertia ixx="0.00101630914167305" ixy="-1.08640924982468E-10" ixz="-1.60895885208619E-07"
               iyy="0.00110356103582406" iyz="-1.18509244220687E-06" izz="0.000517235924522898"/>
    </inertial>
    <visual><geometry><mesh filename="bicep_Link.STL"/></geometry><material name="orange"/></visual>
    <collision><geometry><mesh filename="bicep_Link.STL"/></geometry></collision>
  </link>

  <joint name="R_elbow_bracket_fixed" type="fixed">
    <parent link="R_bicep"/><child link="R_elbow_bracket"/>
    <origin xyz="-2.83612166021019E-05 -0.000342777510980219 -0.125641150102891"/>
  </joint>
  <link name="R_elbow_bracket">
    <inertial>
      <origin xyz="-0.000605555742169805 0.0394739809491743 -0.0108109614483796"/>
      <mass value="0.158178833168892"/>
      <inertia ixx="0.000243570804084392" ixy="-1.31464920678115E-07" ixz="2.56905954631695E-06"
               iyy="0.000332684193087832" iyz="4.1878302215505E-06" izz="0.000317444119465918"/>
    </inertial>
    <visual><geometry><mesh filename="elbow_Link.STL"/></geometry><material name="orange"/></visual>
    <collision><geometry><mesh filename="elbow_Link.STL"/></geometry></collision>
  </link>

  <joint name="R_small_gear_fixed" type="fixed">
    <parent link="R_bicep"/><child link="R_small_gear"/>
    <origin xyz="0.023071638783 0.037757222489 -0.140201150103"/>
  </joint>
  <link name="R_small_gear">
    <inertial>
      <origin xyz="-0.009 0 0"/><mass value="0.00629688353529975"/>
      <inertia ixx="4.33270428790079E-07" ixy="0" ixz="0" iyy="3.86651069848133E-07" iyz="0" izz="3.86651069848133E-07"/>
    </inertial>
    <visual><geometry><mesh filename="small_gear_Link.STL"/></geometry><material name="brass"/></visual>
  </link>

  <joint name="R_elbow" type="revolute">
    <parent link="R_bicep"/><child link="R_forearm"/>
    <origin xyz="-2.83612166021019E-05 0.037758222489 -0.178242150103" rpy="1.5707963 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="2.0944" effort="5.0" velocity="3.0"/>
    <dynamics damping="0.15" friction="0.05"/>
  </joint>
  <link name="R_forearm">
    <inertial>
      <origin xyz="0.000135400 -0.130406796594 0.001104478776"/>
      <mass value="0.138255156587189"/>
      <inertia ixx="0.000259996515223128" ixy="-7.95456854559555E-08" ixz="-2.43754362058068E-09"
               iyy="9.63598208364411E-05" iyz="-5.85531936751054E-06" izz="0.000284931810112051"/>
    </inertial>
    <visual>
      <origin xyz="0.000135398765666483 -0.124737633197 0.024618598898"/>
      <geometry><mesh filename="short_arm_link.STL"/></geometry><material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.000135398765666483 -0.124737633197 0.024618598898"/>
      <geometry><mesh filename="short_arm_link.STL"/></geometry>
    </collision>
  </link>

  <joint name="R_big_gear_fixed" type="fixed">
    <parent link="R_forearm"/><child link="R_big_gear"/>
    <origin xyz="0.0231 0 0"/>
  </joint>
  <link name="R_big_gear">
    <inertial>
      <origin xyz="-0.009 0 0"/><mass value="0.0382194359196154"/>
      <inertia ixx="1.45911616699868E-05" ixy="0" ixz="0" iyy="8.32211862139204E-06" iyz="0" izz="8.33289258825403E-06"/>
    </inertial>
    <visual><geometry><mesh filename="big_gear_Link.STL"/></geometry><material name="brass"/></visual>
  </link>

  <!-- ======================= LEGS (unchanged from v3) ====================== -->
  <joint name="L_hip_flex" type="revolute">
    <parent link="torso"/><child link="L_hip_link"/>
    <origin xyz="0 0.10 0"/><axis xyz="0 -1 0"/>
    <limit lower="-1.0" upper="2.1" effort="80" velocity="8"/>
  </joint>
  <link name="L_hip_link">
    <inertial><mass value="0.05"/><inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="L_hip_abd" type="revolute">
    <parent link="L_hip_link"/><child link="L_thigh"/>
    <origin xyz="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.4" upper="1.2" effort="80" velocity="8"/>
  </joint>
  <link name="L_thigh">
    <visual><geometry><box size="0.09 0.09 0.40"/></geometry><origin xyz="0 0 -0.20"/><material name="blue"/></visual>
    <collision><geometry><box size="0.09 0.09 0.40"/></geometry><origin xyz="0 0 -0.20"/></collision>
    <inertial><mass value="1.5"/><origin xyz="0 0 -0.20"/><inertia ixx="0.02" iyy="0.02" izz="0.003" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="L_knee" type="revolute">
    <parent link="L_thigh"/><child link="L_shin"/>
    <origin xyz="0 0 -0.40"/><axis xyz="0 1 0"/>
    <limit lower="0" upper="2.4" effort="80" velocity="8"/>
  </joint>
  <link name="L_shin">
    <visual><geometry><box size="0.07 0.07 0.40"/></geometry><origin xyz="0 0 -0.20"/><material name="blue"/></visual>
    <collision><geometry><box size="0.07 0.07 0.40"/></geometry><origin xyz="0 0 -0.20"/></collision>
    <inertial><mass value="1.0"/><origin xyz="0 0 -0.20"/><inertia ixx="0.014" iyy="0.014" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="R_hip_flex" type="revolute">
    <parent link="torso"/><child link="R_hip_link"/>
    <origin xyz="0 -0.10 0"/><axis xyz="0 -1 0"/>
    <limit lower="-1.0" upper="2.1" effort="80" velocity="8"/>
  </joint>
  <link name="R_hip_link">
    <inertial><mass value="0.05"/><inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="R_hip_abd" type="revolute">
    <parent link="R_hip_link"/><child link="R_thigh"/>
    <origin xyz="0 0 0"/><axis xyz="-1 0 0"/>
    <limit lower="-0.4" upper="1.2" effort="80" velocity="8"/>
  </joint>
  <link name="R_thigh">
    <visual><geometry><box size="0.09 0.09 0.40"/></geometry><origin xyz="0 0 -0.20"/><material name="orange"/></visual>
    <collision><geometry><box size="0.09 0.09 0.40"/></geometry><origin xyz="0 0 -0.20"/></collision>
    <inertial><mass value="1.5"/><origin xyz="0 0 -0.20"/><inertia ixx="0.02" iyy="0.02" izz="0.003" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="R_knee" type="revolute">
    <parent link="R_thigh"/><child link="R_shin"/>
    <origin xyz="0 0 -0.40"/><axis xyz="0 1 0"/>
    <limit lower="0" upper="2.4" effort="80" velocity="8"/>
  </joint>
  <link name="R_shin">
    <visual><geometry><box size="0.07 0.07 0.40"/></geometry><origin xyz="0 0 -0.20"/><material name="orange"/></visual>
    <collision><geometry><box size="0.07 0.07 0.40"/></geometry><origin xyz="0 0 -0.20"/></collision>
    <inertial><mass value="1.0"/><origin xyz="0 0 -0.20"/><inertia ixx="0.014" iyy="0.014" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

</robot>
