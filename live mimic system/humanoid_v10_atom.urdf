    <collision><origin xyz="0.0000 0.0000 -0.0135"/><geometry><box size="0.0500 0.0620 0.0070"/></geometry></collision>
  </link>

  <joint name="L_shoulder_twist" type="revolute">
    <parent link="L_shoulder_yoke"/><child link="L_shoulder_plate"/>
    <origin xyz="0 0 0"/><axis xyz="0 0 1"/>
    <!-- +/-180: the XH540 does a full turn in position mode. The old +/-90 was
