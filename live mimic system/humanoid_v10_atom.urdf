    <collision><origin xyz="0.0530 -0.0065 -0.0115"/><geometry><box size="0.0060 0.0450 0.0710"/></geometry></collision>
    <collision><origin xyz="-0.0735 -0.0055 -0.0340"/><geometry><box size="0.0350 0.0450 0.0250"/></geometry></collision>
  </link>

  <!-- roll = abduction. 0 hanging, 1.5708 straight out, 2.6180 near overhead.
       The 150 deg ceiling is measured, not guessed: at 165 deg the twisted
       bicep corner reaches the far carrier post. See interference_check.py.
       v9 clamped this to 68..140 deg, which meant the robot physically could
       not put its arms down - that is why it stood there like a scarecrow.
       140 rather than the module's own 150: the CAD check clears 150 against a
       placeholder bicep, but the real ATOM bicep shell grazes the turntable
       flange between 140 and 150 under combined roll and twist. Recovering the
       last 10 deg means moving the pitch turntable 2 mm inboard. -->
  <joint name="L_shoulder_roll" type="revolute">
    <parent link="L_shoulder_carrier"/><child link="L_shoulder_yoke"/>
    <origin xyz="0 0.0025 -0.034"/><axis xyz="1 0 0"/>
    <limit lower="0" upper="2.4435" effort="3.0" velocity="4.2"/>
    <dynamics damping="0.06" friction="0.02"/>
  </joint>

  <link name="L_shoulder_yoke">
    <inertial>
