<?xml version="1.0"?>
<!-- ==========================================================================
     humanoid_v3.urdf  —  the walking figure, now with sideways motion
     ==========================================================================
     Upgrade from humanoid.urdf: each shoulder and hip is now TWO stacked
     hinges instead of one, so limbs can move in 3D:

       *_flex  : forward/back swing.   axis (0 -1 0): positive = FORWARD
       *_abd   : sideways raise.       axis (±1 0 0): positive = AWAY from body
                 (left limbs +x axis, right limbs -x axis, so the convention
                  is symmetric: positive always means "out to the side")

     Elbows and knees stay single hinges (as in humans):
       * elbow axis (0 -1 0), positive folds the forearm FORWARD, lower=0
       * knee  axis (0  1 0), positive folds the shin BACKWARD,  lower=0

     The tiny *_link bodies between the two hinges of a shoulder/hip are
     massless connectors — URDF needs a link between every pair of joints.

     Chain per limb:  torso -> J_flex -> connector -> J_abd -> limb...
     Left limbs are blue, right limbs are orange.
     ========================================================================== -->
<robot name="humanoid_v3">

  <!-- ============================ TORSO (root) ============================ -->
  <link name="torso">
    <visual>
      <geometry><box size="0.20 0.34 0.65"/></geometry>
      <origin xyz="0 0 0.325"/>
      <material name="gray"><color rgba="0.45 0.47 0.52 1"/></material>
    </visual>
    <collision><geometry><box size="0.20 0.34 0.65"/></geometry><origin xyz="0 0 0.325"/></collision>
    <inertial><mass value="8.0"/><inertia ixx="0.1" iyy="0.1" izz="0.05" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual>
      <geometry><sphere radius="0.11"/></geometry>
      <origin xyz="0 0 0.78"/>
      <material name="tan"><color rgba="0.85 0.72 0.6 1"/></material>
    </visual>
  </link>

  <!-- ============================== LEFT ARM ============================== -->
  <joint name="L_shoulder_flex" type="revolute">
    <parent link="torso"/><child link="L_shoulder_link"/>
    <origin xyz="0 0.20 0.6"/><axis xyz="0 -1 0"/>
    <limit lower="-1.2" upper="3.1" effort="30" velocity="8"/>
  </joint>
  <link name="L_shoulder_link">
    <inertial><mass value="0.05"/><inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="L_shoulder_abd" type="revolute">
    <parent link="L_shoulder_link"/><child link="L_uparm"/>
    <origin xyz="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="3.0" effort="30" velocity="8"/>
  </joint>
  <link name="L_uparm">
    <visual><geometry><box size="0.06 0.06 0.30"/></geometry><origin xyz="0 0 -0.15"/>
      <material name="blue"><color rgba="0.2 0.5 0.9 1"/></material></visual>
    <collision><geometry><box size="0.06 0.06 0.30"/></geometry><origin xyz="0 0 -0.15"/></collision>
    <inertial><mass value="0.8"/><origin xyz="0 0 -0.15"/><inertia ixx="0.006" iyy="0.006" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="L_elbow" type="revolute">
    <parent link="L_uparm"/><child link="L_forearm"/>
    <origin xyz="0 0 -0.30"/><axis xyz="0 -1 0"/>
    <limit lower="0" upper="2.7" effort="30" velocity="8"/>
  </joint>
  <link name="L_forearm">
    <visual><geometry><box size="0.05 0.05 0.28"/></geometry><origin xyz="0 0 -0.14"/>
      <material name="blue"/></visual>
    <collision><geometry><box size="0.05 0.05 0.28"/></geometry><origin xyz="0 0 -0.14"/></collision>
    <inertial><mass value="0.6"/><origin xyz="0 0 -0.14"/><inertia ixx="0.004" iyy="0.004" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- ============================= RIGHT ARM ============================= -->
  <joint name="R_shoulder_flex" type="revolute">
    <parent link="torso"/><child link="R_shoulder_link"/>
    <origin xyz="0 -0.20 0.6"/><axis xyz="0 -1 0"/>
    <limit lower="-1.2" upper="3.1" effort="30" velocity="8"/>
  </joint>
  <link name="R_shoulder_link">
    <inertial><mass value="0.05"/><inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="R_shoulder_abd" type="revolute">
    <parent link="R_shoulder_link"/><child link="R_uparm"/>
    <origin xyz="0 0 0"/><axis xyz="-1 0 0"/>
    <limit lower="-0.5" upper="3.0" effort="30" velocity="8"/>
  </joint>
  <link name="R_uparm">
    <visual><geometry><box size="0.06 0.06 0.30"/></geometry><origin xyz="0 0 -0.15"/>
      <material name="orange"><color rgba="0.95 0.55 0.2 1"/></material></visual>
    <collision><geometry><box size="0.06 0.06 0.30"/></geometry><origin xyz="0 0 -0.15"/></collision>
    <inertial><mass value="0.8"/><origin xyz="0 0 -0.15"/><inertia ixx="0.006" iyy="0.006" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="R_elbow" type="revolute">
    <parent link="R_uparm"/><child link="R_forearm"/>
    <origin xyz="0 0 -0.30"/><axis xyz="0 -1 0"/>
    <limit lower="0" upper="2.7" effort="30" velocity="8"/>
  </joint>
  <link name="R_forearm">
    <visual><geometry><box size="0.05 0.05 0.28"/></geometry><origin xyz="0 0 -0.14"/>
      <material name="orange"/></visual>
    <collision><geometry><box size="0.05 0.05 0.28"/></geometry><origin xyz="0 0 -0.14"/></collision>
    <inertial><mass value="0.6"/><origin xyz="0 0 -0.14"/><inertia ixx="0.004" iyy="0.004" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- ============================== LEFT LEG ============================== -->
  <joint name="L_hip_flex" type="revolute">
    <parent link="torso"/><child link="L_hip_link"/>
    <origin xyz="0 0.10 0"/><axis xyz="0 -1 0"/>
    <limit lower="-1.0" upper="2.1" effort="80" velocity="8"/>
  </joint>
  <link name="L_hip_link">
    <inertial><mass value="0.05"/><inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="L_hip_abd" type="revolute">
    <parent link="L_hip_link"/><child link="L_thigh"/>
    <origin xyz="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.4" upper="1.2" effort="80" velocity="8"/>
  </joint>
  <link name="L_thigh">
    <visual><geometry><box size="0.09 0.09 0.40"/></geometry><origin xyz="0 0 -0.20"/>
      <material name="blue"/></visual>
    <collision><geometry><box size="0.09 0.09 0.40"/></geometry><origin xyz="0 0 -0.20"/></collision>
    <inertial><mass value="1.5"/><origin xyz="0 0 -0.20"/><inertia ixx="0.02" iyy="0.02" izz="0.003" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="L_knee" type="revolute">
    <parent link="L_thigh"/><child link="L_shin"/>
    <origin xyz="0 0 -0.40"/><axis xyz="0 1 0"/>
    <limit lower="0" upper="2.4" effort="80" velocity="8"/>
  </joint>
  <link name="L_shin">
    <visual><geometry><box size="0.07 0.07 0.40"/></geometry><origin xyz="0 0 -0.20"/>
      <material name="blue"/></visual>
    <collision><geometry><box size="0.07 0.07 0.40"/></geometry><origin xyz="0 0 -0.20"/></collision>
    <inertial><mass value="1.0"/><origin xyz="0 0 -0.20"/><inertia ixx="0.014" iyy="0.014" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- ============================= RIGHT LEG ============================= -->
  <joint name="R_hip_flex" type="revolute">
    <parent link="torso"/><child link="R_hip_link"/>
    <origin xyz="0 -0.10 0"/><axis xyz="0 -1 0"/>
    <limit lower="-1.0" upper="2.1" effort="80" velocity="8"/>
  </joint>
  <link name="R_hip_link">
    <inertial><mass value="0.05"/><inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="R_hip_abd" type="revolute">
    <parent link="R_hip_link"/><child link="R_thigh"/>
    <origin xyz="0 0 0"/><axis xyz="-1 0 0"/>
    <limit lower="-0.4" upper="1.2" effort="80" velocity="8"/>
  </joint>
  <link name="R_thigh">
    <visual><geometry><box size="0.09 0.09 0.40"/></geometry><origin xyz="0 0 -0.20"/>
      <material name="orange"/></visual>
    <collision><geometry><box size="0.09 0.09 0.40"/></geometry><origin xyz="0 0 -0.20"/></collision>
    <inertial><mass value="1.5"/><origin xyz="0 0 -0.20"/><inertia ixx="0.02" iyy="0.02" izz="0.003" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="R_knee" type="revolute">
    <parent link="R_thigh"/><child link="R_shin"/>
    <origin xyz="0 0 -0.40"/><axis xyz="0 1 0"/>
    <limit lower="0" upper="2.4" effort="80" velocity="8"/>
  </joint>
  <link name="R_shin">
    <visual><geometry><box size="0.07 0.07 0.40"/></geometry><origin xyz="0 0 -0.20"/>
      <material name="orange"/></visual>
    <collision><geometry><box size="0.07 0.07 0.40"/></geometry><origin xyz="0 0 -0.20"/></collision>
    <inertial><mass value="1.0"/><origin xyz="0 0 -0.20"/><inertia ixx="0.014" iyy="0.014" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

</robot>
