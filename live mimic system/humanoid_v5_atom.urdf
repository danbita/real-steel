<?xml version="1.0"?>
<!-- ==========================================================================
     humanoid_v5_atom.urdf  —  real shoulder module + real ATOM arm
     ==========================================================================
     v4 kept the invented 2-hinge shoulder and only swapped the arms. This
     replaces the shoulder too, with the CadQuery 2-servo module from
     cad/shoulder_v1 (in this repo).

     FULL CHAIN PER SIDE
     ===================
       torso
        -[*_shoulder_mount, fixed]-> *_shoulder_base    housing + balls + servo A
          -[*_shoulder_yaw,   Z]-> *_shoulder_yoke    turntable + yoke + servo B
            -[*_shoulder_pitch, Y]-> *_shoulder_arm     C-bracket + gear + shaft
              -[*_arm_adapter, fixed]-> *_bicep         ATOM arm from here down
                -[*_elbow, X]-> *_forearm

     >>> THE DOF CHANGED. READ THIS. <<<
     v3/v4 had shoulder_flex (Y) + shoulder_abd (X). The real hardware does
     PITCH (Y) + YAW (Z). There is no abduction axis - this shoulder physically
     cannot raise the arm out to the side. It can only swing it fore/aft and
     rotate it about vertical. Joints are named honestly (*_shoulder_pitch,
     *_shoulder_yaw); mimic_receiver_v5.py maps the old names onto them and
     documents the approximation.

     PITCH SIGN IS UNCHANGED from v4's flex. The module is mounted inverted
     (rpy="pi 0 0"), which turns the CAD's arm-straight-up neutral into
     arm-hanging-down, and flips the module Y axis so that positive pitch swings
     the arm FORWARD - exactly the old flex convention. Guard/jab poses carry
     over with no retuning.

     WHY INVERTED: measured pitch travel is only -40..+124 deg (the arm's top
     cross-bar strikes the turntable at 126). Mounted upright, "arm down" would
     need 180 deg and be unreachable, leaving the arm permanently raised.

     SHOULDER TRACK: 250 mm from centreline. The bicep sweeps a 72mm-radius
     cylinder about the yaw axis, so the module must sit at least 242mm out or
     ANY yaw rotation drives the bicep into the chest. Measured, not guessed.

     MEASURED TRAVEL (swept in sim against real collision geometry)
       pitch  -70 .. +105 deg. Standalone the module reaches +124 (top cross-bar
              hits the turntable); fitted, the raised bicep hits its own housing
              first at +105.
       yaw    +/-10 deg ONLY. The servo can do +/-90. Pitch and yaw are strongly
              coupled: +yaw clashes with the torso at forward pitch, -yaw at
              backward pitch, so +/-10 is the largest box limit safe everywhere.
              Near pitch 0 up to +/-20 is reachable. As mounted, this DOF is
              close to useless - see the coupling table in the handoff notes.

     MASS: shoulder module 352 g/side (integrated from mesh geometry by
     sim/shoulder_prep.py), ATOM arm 586 g/side.

     KNOWN GAPS  (carried forward + new)
     ===================================
     * NO PHYSICAL BICEP INTERFACE. The C-bracket's plates are 65mm apart; the
       ATOM bicep is 109mm wide, so it cannot sit between them. Here it bolts to
       the underside of the 28x75mm top bar. That mating plate does not exist in
       either CAD model and mechanical has to design it.
     * The torso-to-housing bracket is a placeholder box. No CAD for it.
     * pivot gear overlaps the yoke upright by 1.5mm axially in the source CAD.
     * `forearmelbowV2` still has no STL, so the elbow still has a visible gap.
     * Both sides use identical, non-mirrored parts.
     * Servo effort/velocity are [PLACEHOLDER] pending datasheets.
     ==========================================================================-->
<robot name="humanoid_v5_atom">

  <mujoco>
    <compiler meshdir="meshes/" balanceinertia="true" discardvisual="false"/>
  </mujoco>

  <material name="gray"><color rgba="0.45 0.47 0.52 1"/></material>
  <material name="tan"><color rgba="0.85 0.72 0.6 1"/></material>
  <material name="blue"><color rgba="0.2 0.5 0.9 1"/></material>
  <material name="orange"><color rgba="0.95 0.55 0.2 1"/></material>

  <!-- ============================ TORSO (root) ============================ -->
  <link name="torso">
    <visual>
      <geometry><box size="0.20 0.34 0.65"/></geometry>
      <origin xyz="0 0 0.325"/>
      <material name="gray"/>
    </visual>
    <collision><geometry><box size="0.20 0.34 0.65"/></geometry><origin xyz="0 0 0.325"/></collision>
    <inertial><mass value="8.0"/><inertia ixx="0.1" iyy="0.1" izz="0.05" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual>
      <geometry><sphere radius="0.11"/></geometry>
      <origin xyz="0 0 0.78"/>
      <material name="tan"/>
    </visual>
    <!-- [PLACEHOLDER] brackets bridging the torso side to each housing -->
    <visual><origin xyz="0 0.189 0.632"/><geometry><box size="0.05 0.06 0.05"/></geometry><material name="gray"/></visual>
    <visual><origin xyz="0 -0.189 0.632"/><geometry><box size="0.05 0.06 0.05"/></geometry><material name="gray"/></visual>
  </link>

  <!-- ############################ LEFT SHOULDER ########################### -->
  <!-- rpy="pi 0 0" inverts the module: CAD arm-up neutral becomes arm-down. -->
  <joint name="L_shoulder_mount" type="fixed">
    <parent link="torso"/><child link="L_shoulder_base"/>
    <origin xyz="0 0.25 0.66" rpy="3.1415927 0 0"/>
  </joint>

  <link name="L_shoulder_base">
    <inertial>
      <origin xyz="0.003453 -0.000000 0.028121"/>
      <mass value="0.157633"/>
      <inertia ixx="0.000114156" ixy="0.000000000" ixz="0.000004747"
               iyy="0.000123680" iyz="-0.000000000" izz="0.000165650"/>
    </inertial>
    <visual><geometry><mesh filename="shoulder/housing.stl"/></geometry></visual>
    <visual><geometry><mesh filename="shoulder/balls.stl"/></geometry></visual>
    <visual><geometry><mesh filename="shoulder/servoA_body.stl"/></geometry></visual>
    <collision><origin xyz="0 0 0.023"/><geometry><box size="0.084 0.084 0.046"/></geometry></collision>
  </link>

  <joint name="L_shoulder_yaw" type="revolute">
    <parent link="L_shoulder_base"/><child link="L_shoulder_yoke"/>
    <origin xyz="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-0.1745" upper="0.1745" effort="9.0" velocity="6.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="L_shoulder_yoke">
    <inertial>
      <origin xyz="0.003678 0.002625 0.084187"/>
      <mass value="0.147970"/>
      <inertia ixx="0.000119922" ixy="0.000001102" ixz="-0.000007790"
               iyy="0.000093819" iyz="-0.000005559" izz="0.000083651"/>
    </inertial>
    <visual><geometry><mesh filename="shoulder/servoA_shaft.stl"/></geometry></visual>
    <visual><geometry><mesh filename="shoulder/turntable.stl"/></geometry></visual>
    <visual><geometry><mesh filename="shoulder/yoke.stl"/></geometry></visual>
    <visual><geometry><mesh filename="shoulder/servoB_body.stl"/></geometry></visual>
    <visual><geometry><mesh filename="shoulder/idler_ball.stl"/></geometry></visual>
    <collision><origin xyz="0 0 0.0535"/><geometry><cylinder radius="0.034" length="0.006"/></geometry></collision>
    <collision><origin xyz="0 0 0.059"/><geometry><cylinder radius="0.028" length="0.005"/></geometry></collision>
    <collision><origin xyz="0 0.026 0.0775"/><geometry><box size="0.046 0.008 0.042"/></geometry></collision>
    <collision><origin xyz="0 -0.026 0.0775"/><geometry><box size="0.046 0.008 0.042"/></geometry></collision>
    <collision><origin xyz="0 0.026 0.0985" rpy="1.5707963 0 0"/><geometry><cylinder radius="0.023" length="0.008"/></geometry></collision>
    <collision><origin xyz="0 -0.026 0.0985" rpy="1.5707963 0 0"/><geometry><cylinder radius="0.023" length="0.008"/></geometry></collision>
    <collision><origin xyz="0.010 -0.001 0.0985"/><geometry><box size="0.054 0.042 0.020"/></geometry></collision>
  </link>

  <joint name="L_shoulder_pitch" type="revolute">
    <parent link="L_shoulder_yoke"/><child link="L_shoulder_arm"/>
    <origin xyz="0 0 0.0985"/><axis xyz="0 1 0"/>
    <limit lower="-1.2217" upper="1.8326" effort="9.0" velocity="6.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="L_shoulder_arm">
    <inertial>
      <origin xyz="0.000000 -0.009465 0.021606"/>
      <mass value="0.046075"/>
      <inertia ixx="0.000064745" ixy="-0.000000000" ixz="0.000000000"
               iyy="0.000030878" iyz="-0.000009423" izz="0.000041321"/>
    </inertial>
    <visual><origin xyz="0 0 -0.0985"/><geometry><mesh filename="shoulder/arm.stl"/></geometry></visual>
    <visual><origin xyz="0 0 -0.0985"/><geometry><mesh filename="shoulder/pivot_gear.stl"/></geometry></visual>
    <visual><origin xyz="0 0 -0.0985"/><geometry><mesh filename="shoulder/servoB_shaft.stl"/></geometry></visual>
    <collision><origin xyz="0 0.035 0.024"/><geometry><box size="0.028 0.005 0.058"/></geometry></collision>
    <collision><origin xyz="0 -0.035 0.024"/><geometry><box size="0.028 0.005 0.058"/></geometry></collision>
    <collision><origin xyz="0 0.035 0" rpy="1.5707963 0 0"/><geometry><cylinder radius="0.016" length="0.005"/></geometry></collision>
    <collision><origin xyz="0 -0.035 0" rpy="1.5707963 0 0"/><geometry><cylinder radius="0.016" length="0.005"/></geometry></collision>
    <collision><origin xyz="0 0 0.050"/><geometry><box size="0.028 0.075 0.006"/></geometry></collision>
  </link>

  <!-- ============================== LEFT ARM ============================== -->
  <!-- Takes the C-bracket frame to the ATOM bicep frame: 180deg about X (the
       module is inverted) then -90deg about Z (the ATOM elbow axis is its own X,
       and it has to line up with the shoulder pitch axis). z=0.1386 puts the
       bicep's top face on the underside of the bracket's top bar; x=0.038
       centres the bicep body, which hangs off one side of its own origin. -->
  <joint name="L_arm_adapter" type="fixed">
    <parent link="L_shoulder_arm"/><child link="L_bicep"/>
    <origin xyz="0.038 0 0.1386" rpy="3.1415927 0 -1.5707963"/>
  </joint>

  <link name="L_bicep">
    <inertial>
      <origin xyz="-1.42283694379852E-05 0.0379551502038027 -0.00905701308974227"/>
      <mass value="0.245418330630813"/>
      <inertia ixx="0.00101630914167305" ixy="-1.08640924982468E-10" ixz="-1.60895885208619E-07"
               iyy="0.00110356103582406" iyz="-1.18509244220687E-06" izz="0.000517235924522898"/>
    </inertial>
    <visual><geometry><mesh filename="bicep_Link.STL"/></geometry><material name="blue"/></visual>
    <collision><geometry><mesh filename="bicep_Link.STL"/></geometry></collision>
  </link>

  <joint name="L_elbow_bracket_fixed" type="fixed">
    <parent link="L_bicep"/><child link="L_elbow_bracket"/>
    <origin xyz="-2.83612166021019E-05 -0.000342777510980219 -0.125641150102891"/>
  </joint>
  <link name="L_elbow_bracket">
    <inertial>
      <origin xyz="-0.000605555742169805 0.0394739809491743 -0.0108109614483796"/>
      <mass value="0.158178833168892"/>
      <inertia ixx="0.000243570804084392" ixy="-1.31464920678115E-07" ixz="2.56905954631695E-06"
               iyy="0.000332684193087832" iyz="4.1878302215505E-06" izz="0.000317444119465918"/>
    </inertial>
    <visual><geometry><mesh filename="elbow_Link.STL"/></geometry><material name="blue"/></visual>
    <collision><geometry><mesh filename="elbow_Link.STL"/></geometry></collision>
  </link>

  <joint name="L_small_gear_fixed" type="fixed">
    <parent link="L_bicep"/><child link="L_small_gear"/>
    <origin xyz="0.023071638783 0.037757222489 -0.140201150103"/>
  </joint>
  <link name="L_small_gear">
    <inertial>
      <origin xyz="-0.009 0 0"/><mass value="0.00629688353529975"/>
      <inertia ixx="4.33270428790079E-07" ixy="0" ixz="0" iyy="3.86651069848133E-07" iyz="0" izz="3.86651069848133E-07"/>
    </inertial>
    <visual><geometry><mesh filename="small_gear_Link.STL"/></geometry></visual>
  </link>

  <joint name="L_elbow" type="revolute">
    <parent link="L_bicep"/><child link="L_forearm"/>
    <origin xyz="-2.83612166021019E-05 0.037758222489 -0.178242150103" rpy="1.5707963 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="2.0944" effort="5.0" velocity="3.0"/>
    <dynamics damping="0.15" friction="0.05"/>
  </joint>
  <link name="L_forearm">
    <inertial>
      <origin xyz="0.000135400 -0.130406796594 0.001104478776"/>
      <mass value="0.138255156587189"/>
      <inertia ixx="0.000259996515223128" ixy="-7.95456854559555E-08" ixz="-2.43754362058068E-09"
               iyy="9.63598208364411E-05" iyz="-5.85531936751054E-06" izz="0.000284931810112051"/>
    </inertial>
    <visual><origin xyz="0.000135398765666483 -0.124737633197 0.024618598898"/><geometry><mesh filename="short_arm_link.STL"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0.000135398765666483 -0.124737633197 0.024618598898"/><geometry><mesh filename="short_arm_link.STL"/></geometry></collision>
  </link>

  <joint name="L_big_gear_fixed" type="fixed">
    <parent link="L_forearm"/><child link="L_big_gear"/>
    <origin xyz="0.0231 0 0"/>
  </joint>
  <link name="L_big_gear">
    <inertial>
      <origin xyz="-0.009 0 0"/><mass value="0.0382194359196154"/>
      <inertia ixx="1.45911616699868E-05" ixy="0" ixz="0" iyy="8.32211862139204E-06" iyz="0" izz="8.33289258825403E-06"/>
    </inertial>
    <visual><geometry><mesh filename="big_gear_Link.STL"/></geometry></visual>
  </link>

  <!-- ########################### RIGHT SHOULDER ########################### -->
  <joint name="R_shoulder_mount" type="fixed">
    <parent link="torso"/><child link="R_shoulder_base"/>
    <origin xyz="0 -0.25 0.66" rpy="3.1415927 0 0"/>
  </joint>

  <link name="R_shoulder_base">
    <inertial>
      <origin xyz="0.003453 -0.000000 0.028121"/>
      <mass value="0.157633"/>
      <inertia ixx="0.000114156" ixy="0.000000000" ixz="0.000004747"
               iyy="0.000123680" iyz="-0.000000000" izz="0.000165650"/>
    </inertial>
    <visual><geometry><mesh filename="shoulder/housing.stl"/></geometry></visual>
    <visual><geometry><mesh filename="shoulder/balls.stl"/></geometry></visual>
    <visual><geometry><mesh filename="shoulder/servoA_body.stl"/></geometry></visual>
    <collision><origin xyz="0 0 0.023"/><geometry><box size="0.084 0.084 0.046"/></geometry></collision>
  </link>

  <joint name="R_shoulder_yaw" type="revolute">
    <parent link="R_shoulder_base"/><child link="R_shoulder_yoke"/>
    <origin xyz="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-0.1745" upper="0.1745" effort="9.0" velocity="6.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="R_shoulder_yoke">
    <inertial>
      <origin xyz="0.003678 0.002625 0.084187"/>
      <mass value="0.147970"/>
      <inertia ixx="0.000119922" ixy="0.000001102" ixz="-0.000007790"
               iyy="0.000093819" iyz="-0.000005559" izz="0.000083651"/>
    </inertial>
    <visual><geometry><mesh filename="shoulder/servoA_shaft.stl"/></geometry></visual>
    <visual><geometry><mesh filename="shoulder/turntable.stl"/></geometry></visual>
    <visual><geometry><mesh filename="shoulder/yoke.stl"/></geometry></visual>
    <visual><geometry><mesh filename="shoulder/servoB_body.stl"/></geometry></visual>
    <visual><geometry><mesh filename="shoulder/idler_ball.stl"/></geometry></visual>
    <collision><origin xyz="0 0 0.0535"/><geometry><cylinder radius="0.034" length="0.006"/></geometry></collision>
    <collision><origin xyz="0 0 0.059"/><geometry><cylinder radius="0.028" length="0.005"/></geometry></collision>
    <collision><origin xyz="0 0.026 0.0775"/><geometry><box size="0.046 0.008 0.042"/></geometry></collision>
    <collision><origin xyz="0 -0.026 0.0775"/><geometry><box size="0.046 0.008 0.042"/></geometry></collision>
    <collision><origin xyz="0 0.026 0.0985" rpy="1.5707963 0 0"/><geometry><cylinder radius="0.023" length="0.008"/></geometry></collision>
    <collision><origin xyz="0 -0.026 0.0985" rpy="1.5707963 0 0"/><geometry><cylinder radius="0.023" length="0.008"/></geometry></collision>
    <collision><origin xyz="0.010 -0.001 0.0985"/><geometry><box size="0.054 0.042 0.020"/></geometry></collision>
  </link>

  <joint name="R_shoulder_pitch" type="revolute">
    <parent link="R_shoulder_yoke"/><child link="R_shoulder_arm"/>
    <origin xyz="0 0 0.0985"/><axis xyz="0 1 0"/>
    <limit lower="-1.2217" upper="1.8326" effort="9.0" velocity="6.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="R_shoulder_arm">
    <inertial>
      <origin xyz="0.000000 -0.009465 0.021606"/>
      <mass value="0.046075"/>
      <inertia ixx="0.000064745" ixy="-0.000000000" ixz="0.000000000"
               iyy="0.000030878" iyz="-0.000009423" izz="0.000041321"/>
    </inertial>
    <visual><origin xyz="0 0 -0.0985"/><geometry><mesh filename="shoulder/arm.stl"/></geometry></visual>
    <visual><origin xyz="0 0 -0.0985"/><geometry><mesh filename="shoulder/pivot_gear.stl"/></geometry></visual>
    <visual><origin xyz="0 0 -0.0985"/><geometry><mesh filename="shoulder/servoB_shaft.stl"/></geometry></visual>
    <collision><origin xyz="0 0.035 0.024"/><geometry><box size="0.028 0.005 0.058"/></geometry></collision>
    <collision><origin xyz="0 -0.035 0.024"/><geometry><box size="0.028 0.005 0.058"/></geometry></collision>
    <collision><origin xyz="0 0.035 0" rpy="1.5707963 0 0"/><geometry><cylinder radius="0.016" length="0.005"/></geometry></collision>
    <collision><origin xyz="0 -0.035 0" rpy="1.5707963 0 0"/><geometry><cylinder radius="0.016" length="0.005"/></geometry></collision>
    <collision><origin xyz="0 0 0.050"/><geometry><box size="0.028 0.075 0.006"/></geometry></collision>
  </link>

  <!-- ============================= RIGHT ARM ============================= -->
  <joint name="R_arm_adapter" type="fixed">
    <parent link="R_shoulder_arm"/><child link="R_bicep"/>
    <origin xyz="0.038 0 0.1386" rpy="3.1415927 0 -1.5707963"/>
  </joint>

  <link name="R_bicep">
    <inertial>
      <origin xyz="-1.42283694379852E-05 0.0379551502038027 -0.00905701308974227"/>
      <mass value="0.245418330630813"/>
      <inertia ixx="0.00101630914167305" ixy="-1.08640924982468E-10" ixz="-1.60895885208619E-07"
               iyy="0.00110356103582406" iyz="-1.18509244220687E-06" izz="0.000517235924522898"/>
    </inertial>
    <visual><geometry><mesh filename="bicep_Link.STL"/></geometry><material name="orange"/></visual>
    <collision><geometry><mesh filename="bicep_Link.STL"/></geometry></collision>
  </link>

  <joint name="R_elbow_bracket_fixed" type="fixed">
    <parent link="R_bicep"/><child link="R_elbow_bracket"/>
    <origin xyz="-2.83612166021019E-05 -0.000342777510980219 -0.125641150102891"/>
  </joint>
  <link name="R_elbow_bracket">
    <inertial>
      <origin xyz="-0.000605555742169805 0.0394739809491743 -0.0108109614483796"/>
      <mass value="0.158178833168892"/>
      <inertia ixx="0.000243570804084392" ixy="-1.31464920678115E-07" ixz="2.56905954631695E-06"
               iyy="0.000332684193087832" iyz="4.1878302215505E-06" izz="0.000317444119465918"/>
    </inertial>
    <visual><geometry><mesh filename="elbow_Link.STL"/></geometry><material name="orange"/></visual>
    <collision><geometry><mesh filename="elbow_Link.STL"/></geometry></collision>
  </link>

  <joint name="R_small_gear_fixed" type="fixed">
    <parent link="R_bicep"/><child link="R_small_gear"/>
    <origin xyz="0.023071638783 0.037757222489 -0.140201150103"/>
  </joint>
  <link name="R_small_gear">
    <inertial>
      <origin xyz="-0.009 0 0"/><mass value="0.00629688353529975"/>
      <inertia ixx="4.33270428790079E-07" ixy="0" ixz="0" iyy="3.86651069848133E-07" iyz="0" izz="3.86651069848133E-07"/>
    </inertial>
    <visual><geometry><mesh filename="small_gear_Link.STL"/></geometry></visual>
  </link>

  <joint name="R_elbow" type="revolute">
    <parent link="R_bicep"/><child link="R_forearm"/>
    <origin xyz="-2.83612166021019E-05 0.037758222489 -0.178242150103" rpy="1.5707963 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="2.0944" effort="5.0" velocity="3.0"/>
    <dynamics damping="0.15" friction="0.05"/>
  </joint>
  <link name="R_forearm">
    <inertial>
      <origin xyz="0.000135400 -0.130406796594 0.001104478776"/>
      <mass value="0.138255156587189"/>
      <inertia ixx="0.000259996515223128" ixy="-7.95456854559555E-08" ixz="-2.43754362058068E-09"
               iyy="9.63598208364411E-05" iyz="-5.85531936751054E-06" izz="0.000284931810112051"/>
    </inertial>
    <visual><origin xyz="0.000135398765666483 -0.124737633197 0.024618598898"/><geometry><mesh filename="short_arm_link.STL"/></geometry><material name="orange"/></visual>
    <collision><origin xyz="0.000135398765666483 -0.124737633197 0.024618598898"/><geometry><mesh filename="short_arm_link.STL"/></geometry></collision>
  </link>

  <joint name="R_big_gear_fixed" type="fixed">
    <parent link="R_forearm"/><child link="R_big_gear"/>
    <origin xyz="0.0231 0 0"/>
  </joint>
  <link name="R_big_gear">
    <inertial>
      <origin xyz="-0.009 0 0"/><mass value="0.0382194359196154"/>
      <inertia ixx="1.45911616699868E-05" ixy="0" ixz="0" iyy="8.32211862139204E-06" iyz="0" izz="8.33289258825403E-06"/>
    </inertial>
    <visual><geometry><mesh filename="big_gear_Link.STL"/></geometry></visual>
  </link>

  <!-- ======================= LEGS (unchanged from v3) ====================== -->
  <joint name="L_hip_flex" type="revolute">
