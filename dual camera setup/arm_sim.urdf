<?xml version="1.0"?>
<!-- ==========================================================================
     arm_sim.urdf — simulation stand-in for the physical arm (armRosFile)
     ==========================================================================
     The SolidWorks export (armRosFile.urdf) has all joints fixed/zero-range
     and references STL meshes we don't have yet, so this file recreates the
     arm as a SIMULATABLE model:

       shoulder_flex : revolute about y-axis, -90..+90 deg (180 deg total)
                       positive = arm swings FORWARD (+x), matches v3 convention
       shoulder_abd  : revolute about x-axis, -90..+90 deg (180 deg total)
                       positive = arm swings OUT to the side
       elbow         : revolute, 0..150 deg, positive folds forearm forward.
                       If the physical arm's elbow isn't actuated yet, leave it;
                       the receiver simply won't command it.

     Masses/inertias approximated from the SolidWorks export. Geometry is
     primitive boxes until the real meshes/ folder is available — then the
     visual elements can be swapped for <mesh filename="meshes/..."/>.
     ========================================================================== -->
<robot name="arm_sim">

  <!-- fixed mounting column so the arm hangs at a visible height -->
  <link name="mount">
    <visual>
      <geometry><box size="0.14 0.14 0.60"/></geometry>
      <origin xyz="0 0 0.30"/>
      <material name="gray"><color rgba="0.45 0.47 0.52 1"/></material>
    </visual>
    <inertial><mass value="5.0"/><inertia ixx="0.1" iyy="0.1" izz="0.05" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- base plate = arm_link in the SolidWorks export (mass 0.628 kg) -->
  <joint name="base_fix" type="fixed">
    <parent link="mount"/><child link="arm_base"/>
    <origin xyz="0 0 0.60"/>
  </joint>
  <link name="arm_base">
    <visual>
      <geometry><box size="0.12 0.12 0.05"/></geometry>
      <origin xyz="0 0 0.025"/>
      <material name="steel"><color rgba="0.79 0.82 0.93 1"/></material>
    </visual>
    <inertial><mass value="0.628"/><inertia ixx="0.0016" iyy="0.0016" izz="0.0012" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- ============ 2-DOF SHOULDER: 180 deg about y, 180 deg about x ======== -->
  <joint name="shoulder_flex" type="revolute">
    <parent link="arm_base"/><child link="shoulder_link"/>
    <origin xyz="0 0 0"/><axis xyz="0 -1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="30" velocity="6"/>
  </joint>
  <link name="shoulder_link">
    <inertial><mass value="0.05"/><inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="shoulder_abd" type="revolute">
    <parent link="shoulder_link"/><child link="bicep"/>
    <origin xyz="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="30" velocity="6"/>
  </joint>

  <!-- bicep = upper segment (bicep_Link, 0.245 kg; export puts the elbow
       assembly ~12.6 cm along the arm — segment drawn 20 cm for visibility) -->
  <link name="bicep">
    <visual>
      <geometry><box size="0.055 0.055 0.20"/></geometry>
      <origin xyz="0 0 -0.10"/>
      <material name="steel"/>
    </visual>
    <collision><geometry><box size="0.055 0.055 0.20"/></geometry><origin xyz="0 0 -0.10"/></collision>
    <inertial><mass value="0.245"/><origin xyz="0 0 -0.10"/><inertia ixx="0.0011" iyy="0.0011" izz="0.0005" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- elbow = the gear-driven joint in the export (big_gear/small_gear about x) -->
  <joint name="elbow" type="revolute">
    <parent link="bicep"/><child link="forearm"/>
    <origin xyz="0 0 -0.20"/><axis xyz="0 -1 0"/>
    <limit lower="0" upper="2.618" effort="30" velocity="6"/>
  </joint>
  <link name="forearm">
    <visual>
      <geometry><box size="0.045 0.045 0.18"/></geometry>
      <origin xyz="0 0 -0.09"/>
      <material name="cream"><color rgba="1 0.95 0.91 1"/></material>
    </visual>
    <collision><geometry><box size="0.045 0.045 0.18"/></geometry><origin xyz="0 0 -0.09"/></collision>
    <inertial><mass value="0.158"/><origin xyz="0 0 -0.09"/><inertia ixx="0.0003" iyy="0.0003" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

</robot>
