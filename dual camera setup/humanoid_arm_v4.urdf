<?xml version="1.0"?>
<!-- ==========================================================================
     humanoid_arm_v4.urdf — humanoid body carrying two replicas of the
     PHYSICAL ARM (arm_sim / armRosFile), with v3 legs.
     ==========================================================================
     Arms are exact copies of the physical arm's joint structure:
       *_shoulder_flex : about y, -90..+90 deg  (the arm's 180 deg about y)
       *_shoulder_abd  : about x, -90..+90 deg  (the arm's 180 deg about x)
                         positive = away from the body, both sides
       *_elbow         : gear-driven joint, 0..150 deg
     Segment sizes/masses match arm_sim.urdf (bicep 0.20 m / 0.245 kg,
     forearm 0.18 m / 0.158 kg), drawn in the physical arm's steel/cream
     colors so it's obvious these ARE the hardware arms.

     Legs are the familiar v3 legs (hip flex+abd, knee), blue=left,
     orange=right.

     Torso is 0.32 wide (slimmer than v3's 0.34) so hanging arms have real
     clearance; every segment has a collision box, and the receiver runs a
     contact check each tick so limbs cannot pass through the body.
     ========================================================================== -->
<robot name="humanoid_arm_v4">

  <link name="torso">
    <visual>
      <geometry><box size="0.20 0.32 0.65"/></geometry>
      <origin xyz="0 0 0.325"/>
      <material name="gray"><color rgba="0.45 0.47 0.52 1"/></material>
    </visual>
    <collision><geometry><box size="0.20 0.32 0.65"/></geometry><origin xyz="0 0 0.325"/></collision>
    <inertial><mass value="8.0"/><inertia ixx="0.1" iyy="0.1" izz="0.05" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual>
      <geometry><sphere radius="0.11"/></geometry>
      <origin xyz="0 0 0.78"/>
      <material name="tan"><color rgba="0.85 0.72 0.6 1"/></material>
    </visual>
  </link>

  <!-- ================= LEFT ARM (physical-arm replica) ================== -->
  <joint name="L_shoulder_flex" type="revolute">
    <parent link="torso"/><child link="L_shoulder_link"/>
    <origin xyz="0 0.20 0.6"/><axis xyz="0 -1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="30" velocity="6"/>
  </joint>
  <link name="L_shoulder_link">
    <inertial><mass value="0.05"/><inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="L_shoulder_abd" type="revolute">
    <parent link="L_shoulder_link"/><child link="L_bicep"/>
    <origin xyz="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="30" velocity="6"/>
  </joint>
  <link name="L_bicep">
    <visual><geometry><box size="0.055 0.055 0.20"/></geometry><origin xyz="0 0 -0.10"/>
      <material name="steel"><color rgba="0.79 0.82 0.93 1"/></material></visual>
    <collision><geometry><box size="0.055 0.055 0.20"/></geometry><origin xyz="0 0 -0.10"/></collision>
    <inertial><mass value="0.245"/><origin xyz="0 0 -0.10"/><inertia ixx="0.0011" iyy="0.0011" izz="0.0005" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="L_elbow" type="revolute">
    <parent link="L_bicep"/><child link="L_forearm"/>
    <origin xyz="0 0 -0.20"/><axis xyz="0 -1 0"/>
    <limit lower="0" upper="2.618" effort="30" velocity="6"/>
  </joint>
  <link name="L_forearm">
    <visual><geometry><box size="0.045 0.045 0.18"/></geometry><origin xyz="0 0 -0.09"/>
      <material name="cream"><color rgba="1 0.95 0.91 1"/></material></visual>
    <collision><geometry><box size="0.045 0.045 0.18"/></geometry><origin xyz="0 0 -0.09"/></collision>
    <inertial><mass value="0.158"/><origin xyz="0 0 -0.09"/><inertia ixx="0.0003" iyy="0.0003" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- ================= RIGHT ARM (physical-arm replica) ================= -->
  <joint name="R_shoulder_flex" type="revolute">
    <parent link="torso"/><child link="R_shoulder_link"/>
    <origin xyz="0 -0.20 0.6"/><axis xyz="0 -1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="30" velocity="6"/>
  </joint>
  <link name="R_shoulder_link">
    <inertial><mass value="0.05"/><inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="R_shoulder_abd" type="revolute">
    <parent link="R_shoulder_link"/><child link="R_bicep"/>
    <origin xyz="0 0 0"/><axis xyz="-1 0 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="30" velocity="6"/>
  </joint>
  <link name="R_bicep">
    <visual><geometry><box size="0.055 0.055 0.20"/></geometry><origin xyz="0 0 -0.10"/>
      <material name="steel"/></visual>
    <collision><geometry><box size="0.055 0.055 0.20"/></geometry><origin xyz="0 0 -0.10"/></collision>
    <inertial><mass value="0.245"/><origin xyz="0 0 -0.10"/><inertia ixx="0.0011" iyy="0.0011" izz="0.0005" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="R_elbow" type="revolute">
    <parent link="R_bicep"/><child link="R_forearm"/>
    <origin xyz="0 0 -0.20"/><axis xyz="0 -1 0"/>
    <limit lower="0" upper="2.618" effort="30" velocity="6"/>
  </joint>
  <link name="R_forearm">
    <visual><geometry><box size="0.045 0.045 0.18"/></geometry><origin xyz="0 0 -0.09"/>
      <material name="cream"/></visual>
    <collision><geometry><box size="0.045 0.045 0.18"/></geometry><origin xyz="0 0 -0.09"/></collision>
    <inertial><mass value="0.158"/><origin xyz="0 0 -0.09"/><inertia ixx="0.0003" iyy="0.0003" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- ======================== LEFT LEG (v3) ============================= -->
  <joint name="L_hip_flex" type="revolute">
    <parent link="torso"/><child link="L_hip_link"/>
    <origin xyz="0 0.10 0"/><axis xyz="0 -1 0"/>
    <limit lower="-1.0" upper="2.1" effort="80" velocity="8"/>
  </joint>
  <link name="L_hip_link">
    <inertial><mass value="0.05"/><inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="L_hip_abd" type="revolute">
    <parent link="L_hip_link"/><child link="L_thigh"/>
    <origin xyz="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.4" upper="1.2" effort="80" velocity="8"/>
  </joint>
  <link name="L_thigh">
    <visual><geometry><box size="0.09 0.09 0.40"/></geometry><origin xyz="0 0 -0.20"/>
      <material name="blue"><color rgba="0.2 0.5 0.9 1"/></material></visual>
    <collision><geometry><box size="0.09 0.09 0.40"/></geometry><origin xyz="0 0 -0.20"/></collision>
    <inertial><mass value="1.5"/><origin xyz="0 0 -0.20"/><inertia ixx="0.02" iyy="0.02" izz="0.003" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="L_knee" type="revolute">
    <parent link="L_thigh"/><child link="L_shin"/>
    <origin xyz="0 0 -0.40"/><axis xyz="0 1 0"/>
    <limit lower="0" upper="2.4" effort="80" velocity="8"/>
  </joint>
  <link name="L_shin">
    <visual><geometry><box size="0.07 0.07 0.40"/></geometry><origin xyz="0 0 -0.20"/>
      <material name="blue"/></visual>
    <collision><geometry><box size="0.07 0.07 0.40"/></geometry><origin xyz="0 0 -0.20"/></collision>
    <inertial><mass value="1.0"/><origin xyz="0 0 -0.20"/><inertia ixx="0.014" iyy="0.014" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <!-- ======================== RIGHT LEG (v3) ============================ -->
  <joint name="R_hip_flex" type="revolute">
    <parent link="torso"/><child link="R_hip_link"/>
    <origin xyz="0 -0.10 0"/><axis xyz="0 -1 0"/>
    <limit lower="-1.0" upper="2.1" effort="80" velocity="8"/>
  </joint>
  <link name="R_hip_link">
    <inertial><mass value="0.05"/><inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="R_hip_abd" type="revolute">
    <parent link="R_hip_link"/><child link="R_thigh"/>
    <origin xyz="0 0 0"/><axis xyz="-1 0 0"/>
    <limit lower="-0.4" upper="1.2" effort="80" velocity="8"/>
  </joint>
  <link name="R_thigh">
    <visual><geometry><box size="0.09 0.09 0.40"/></geometry><origin xyz="0 0 -0.20"/>
      <material name="orange"><color rgba="0.95 0.55 0.2 1"/></material></visual>
    <collision><geometry><box size="0.09 0.09 0.40"/></geometry><origin xyz="0 0 -0.20"/></collision>
    <inertial><mass value="1.5"/><origin xyz="0 0 -0.20"/><inertia ixx="0.02" iyy="0.02" izz="0.003" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="R_knee" type="revolute">
    <parent link="R_thigh"/><child link="R_shin"/>
    <origin xyz="0 0 -0.40"/><axis xyz="0 1 0"/>
    <limit lower="0" upper="2.4" effort="80" velocity="8"/>
  </joint>
  <link name="R_shin">
    <visual><geometry><box size="0.07 0.07 0.40"/></geometry><origin xyz="0 0 -0.20"/>
      <material name="orange"/></visual>
    <collision><geometry><box size="0.07 0.07 0.40"/></geometry><origin xyz="0 0 -0.20"/></collision>
    <inertial><mass value="1.0"/><origin xyz="0 0 -0.20"/><inertia ixx="0.014" iyy="0.014" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

</robot>
